# Desarrollador Único: Molina Cortez Maikol Anthony
# FICCT - UAGRM | Semestre II-2026

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend requirements
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy codebase
COPY backend/ ./backend/
COPY frontend/ ./frontend/
COPY sitio_web_corporativo/ ./sitio_web_corporativo/

# Create persistent storage dir
RUN mkdir -p /app/storage/profiles /app/storage/drafts

ENV PYTHONUNBUFFERED=1
ENV PORT=8000

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
